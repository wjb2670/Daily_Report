{
  "name": "DrawRequest",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "draw_number": {
      "type": "number"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "paid"
      ],
      "default": "draft"
    },
    "total_amount": {
      "type": "number"
    },
    "retainage_held": {
      "type": "number"
    },
    "net_amount": {
      "type": "number"
    },
    "submitted_date": {
      "type": "string",
      "format": "date"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "draw_number"
  ]
}